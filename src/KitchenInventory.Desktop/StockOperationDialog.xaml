<Window x:Class="KitchenInventory.Desktop.StockOperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:val="clr-namespace:KitchenInventory.Desktop.Validations"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Item Selection -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Item:"/>
        <ComboBox Grid.Row="0" Grid.Column="1" 
                  ItemsSource="{Binding AvailableItems}" 
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  DisplayMemberPath="Name" 
                  IsEnabled="{Binding IsItemSelectionEnabled}"
                  Validation.ErrorTemplate="{x:Null}"
                  AutomationProperties.AutomationId="ItemComboBox"/>

        <!-- Current Stock Display -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Stock:"/>
        <TextBlock Grid.Row="1" Grid.Column="1" 
                   Text="{Binding CurrentStockDisplay}" 
                   FontWeight="SemiBold" 
                   Foreground="{Binding CurrentStockBrush}"
                   AutomationProperties.AutomationId="CurrentStockText"/>

        <!-- Operation Type -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Operation:"/>
        <ComboBox Grid.Row="2" Grid.Column="1" 
                  ItemsSource="{Binding OperationTypes}" 
                  SelectedItem="{Binding SelectedOperationType, Mode=TwoWay}"
                  IsEnabled="{Binding IsOperationSelectable}"
                  AutomationProperties.AutomationId="OperationTypeComboBox"/>

        <!-- Quantity Input -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantity:"/>
        <TextBox Grid.Row="3" Grid.Column="1" 
                 PreviewTextInput="Quantity_PreviewTextInput"
                 DataObject.Pasting="Quantity_Pasting"
                 AutomationProperties.AutomationId="QuantityTextBox">
            <TextBox.Text>
                <Binding Path="Quantity" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" 
                         NotifyOnValidationError="True" ValidatesOnExceptions="True">
                    <Binding.ValidationRules>
                        <val:DoubleRangeValidationRule Min="0.001" Max="1000000" AllowEmpty="False"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <!-- Reason Input -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Reason:"/>
        <TextBox Grid.Row="4" Grid.Column="1" 
                 Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="200"
                 AutomationProperties.AutomationId="ReasonTextBox"/>

        <!-- User Input -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="User:"/>
        <TextBox Grid.Row="5" Grid.Column="1" 
                 Text="{Binding User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="100"
                 AutomationProperties.AutomationId="UserTextBox"/>

        <!-- Preview/Calculation -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="New Stock:"/>
        <TextBlock Grid.Row="6" Grid.Column="1" 
                   Text="{Binding NewStockDisplay}" 
                   FontWeight="SemiBold" 
                   Foreground="{Binding NewStockBrush}"
                   AutomationProperties.AutomationId="NewStockText"/>

        <!-- Validation Errors -->
        <Border Grid.Row="7" Grid.ColumnSpan="2" 
                Background="#FFFFE6E6" BorderBrush="#FFFF6B6B" BorderThickness="1" 
                Padding="8" Margin="0,8,0,8"
                Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="ValidationErrorPanel">
            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#FFCC0000" 
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ErrorMessageText"/>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="8" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Execute" Width="80" Margin="0,0,8,0" 
                        IsDefault="True" 
                        Click="Execute_Click" 
                        IsEnabled="{Binding CanExecute}"
                        AutomationProperties.AutomationId="ExecuteButton"/>
                <Button Content="Cancel" Width="80" IsCancel="True"
                        AutomationProperties.AutomationId="CancelButton"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>