<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Design tokens for Kitchen Inventory.

        The palette, spacing, radii and control metrics live here and nowhere else, so a colour
        or size is decided once. Everything in Controls.xaml and every window should reference
        these keys rather than writing a literal colour, so a later change (a dark theme, for
        example) is a change to this file rather than a hunt through seventeen screens.

        Source: kitchen-inventory-ui-ux-specification.md and the palette in ui-ux-review.html.
    -->

    <!-- ==================== Palette ==================== -->
    <Color x:Key="Color.Primary">#FF2563EB</Color>
    <Color x:Key="Color.PrimaryHover">#FF1D4ED8</Color>
    <Color x:Key="Color.PrimarySurface">#FFEFF6FF</Color>
    <Color x:Key="Color.PrimarySurfaceStrong">#FFDBEAFE</Color>

    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF9FAFB</Color>
    <Color x:Key="Color.SurfaceSunken">#FFF3F4F6</Color>
    <Color x:Key="Color.Border">#FFE5E7EB</Color>
    <Color x:Key="Color.BorderStrong">#FFD1D5DB</Color>

    <Color x:Key="Color.Text">#FF111827</Color>
    <Color x:Key="Color.TextMuted">#FF4B5563</Color>
    <Color x:Key="Color.TextSubtle">#FF6B7280</Color>
    <Color x:Key="Color.TextOnPrimary">#FFFFFFFF</Color>

    <Color x:Key="Color.Success">#FF059669</Color>
    <Color x:Key="Color.SuccessSurface">#FFECFDF5</Color>
    <Color x:Key="Color.Warning">#FFB45309</Color>
    <Color x:Key="Color.WarningStrong">#FF92400E</Color>
    <Color x:Key="Color.WarningSurface">#FFFFFBEB</Color>
    <Color x:Key="Color.WarningBorder">#FFFDE68A</Color>
    <Color x:Key="Color.Danger">#FFDC2626</Color>
    <Color x:Key="Color.DangerHover">#FFB91C1C</Color>
    <Color x:Key="Color.DangerSurface">#FFFEF2F2</Color>
    <Color x:Key="Color.DangerBorder">#FFFECACA</Color>

    <Color x:Key="Color.DisabledSurface">#FFF3F4F6</Color>
    <Color x:Key="Color.DisabledText">#FF9CA3AF</Color>

    <!-- ==================== Brushes ==================== -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimarySurface" Color="{StaticResource Color.PrimarySurface}" />
    <SolidColorBrush x:Key="Brush.PrimarySurfaceStrong" Color="{StaticResource Color.PrimarySurfaceStrong}" />

    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{StaticResource Color.SuccessSurface}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningStrong" Color="{StaticResource Color.WarningStrong}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{StaticResource Color.WarningSurface}" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="{StaticResource Color.WarningBorder}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="{StaticResource Color.DangerBorder}" />

    <SolidColorBrush x:Key="Brush.DisabledSurface" Color="{StaticResource Color.DisabledSurface}" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="{StaticResource Color.DisabledText}" />

    <!-- A row that needs attention: the whole row is tinted, so the colour must stay light
         enough that the ordinary dark text on it keeps its contrast. -->
    <SolidColorBrush x:Key="Brush.AttentionRow" Color="{StaticResource Color.WarningSurface}" />

    <!-- ==================== Typography ==================== -->
    <FontFamily x:Key="Font.Family">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

    <sys:Double x:Key="Font.Size.Base">15</sys:Double>
    <sys:Double x:Key="Font.Size.Control">13.5</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Size.Heading">17</sys:Double>
    <sys:Double x:Key="Font.Size.Display">22</sys:Double>

    <!-- ==================== Spacing (4px base) ==================== -->
    <Thickness x:Key="Spacing.Xs">4</Thickness>
    <Thickness x:Key="Spacing.Sm">8</Thickness>
    <Thickness x:Key="Spacing.Md">16</Thickness>
    <Thickness x:Key="Spacing.Lg">24</Thickness>

    <!-- Horizontal-only insets, for controls that set their own vertical padding. -->
    <Thickness x:Key="Spacing.ControlPadding">14,0</Thickness>
    <Thickness x:Key="Spacing.PagePadding">16</Thickness>

    <!-- ==================== Radii ==================== -->
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>

    <!-- ==================== Metrics ==================== -->
    <!-- Comfortable targets: the review's 38 px controls and 44 px rows. -->
    <sys:Double x:Key="Metric.ControlHeight">38</sys:Double>
    <sys:Double x:Key="Metric.RowHeight">44</sys:Double>
    <sys:Double x:Key="Metric.HeaderHeight">36</sys:Double>
    <sys:Double x:Key="Metric.IconSize">18</sys:Double>
    <!-- Adjacent controls need at least this much air, or a mis-click lands on Delete. -->
    <sys:Double x:Key="Metric.ControlGap">8</sys:Double>

</ResourceDictionary>
