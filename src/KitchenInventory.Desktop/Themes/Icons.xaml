<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Line icons drawn as stroked geometry on a 24x24 canvas, in the style of Lucide.

        They are *centre lines*: the control renders them with Stroke, not Fill, so a single
        1.8 px stroke reads correctly at 18 px. Icons are always shown beside their word — an
        icon on its own is a puzzle for someone who does not already know the app.
    -->

    <!-- Refresh: a clockwise arrow that has come almost full circle. -->
    <PathGeometry x:Key="Icon.Refresh"
                  Figures="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8 M21 3v5h-5" />

    <PathGeometry x:Key="Icon.Add" Figures="M12 5v14 M5 12h14" />

    <PathGeometry x:Key="Icon.Remove"
                  Figures="M4 6h16 M8 6V4h8v2 M6 6l1 15h10l1-15 M10 11v6 M14 11v6" />

    <PathGeometry x:Key="Icon.Save"
                  Figures="M15 3a2 2 0 0 1 1.4.6l4 4A2 2 0 0 1 21 9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-7H7v7 M7 3v4h8" />

    <!-- Stock in: an arrow coming down into the store. -->
    <PathGeometry x:Key="Icon.StockIn"
                  Figures="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3" />

    <!-- Stock out: the same picture, the other way. -->
    <PathGeometry x:Key="Icon.StockOut"
                  Figures="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12" />

    <!-- Recount: a clipboard with a tick against the counted quantity. -->
    <GeometryGroup x:Key="Icon.Recount">
        <PathGeometry Figures="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
        <RectangleGeometry Rect="9,3 6,4" />
        <PathGeometry Figures="M9 14l2 2 4-4" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Import" Figures="M12 17V3 M6 11l6 6 6-6 M19 21H5" />

    <PathGeometry x:Key="Icon.Export" Figures="M12 3v14 M6 9l6-6 6 6 M19 21H5" />

    <!-- Categories: a luggage tag. -->
    <GeometryGroup x:Key="Icon.Category">
        <PathGeometry Figures="M3 11V4a1 1 0 0 1 1-1h7l9.3 9.3a1 1 0 0 1 0 1.4l-6.6 6.6a1 1 0 0 1-1.4 0z" />
        <EllipseGeometry Center="7.5,7.5" RadiusX="1" RadiusY="1" />
    </GeometryGroup>

    <!-- Locations: a map pin. -->
    <GeometryGroup x:Key="Icon.Location">
        <PathGeometry Figures="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0" />
        <EllipseGeometry Center="12,10" RadiusX="3" RadiusY="3" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Convert" Figures="M8 3L4 7l4 4 M4 7h16 M16 21l4-4-4-4 M20 17H4" />

    <PathGeometry x:Key="Icon.Reports"
                  Figures="M3 3v16a2 2 0 0 0 2 2h16 M8 17v-5 M13 17V8 M18 17v-9" />

    <PathGeometry x:Key="Icon.Undo"
                  Figures="M3 12a9 9 0 1 0 9-9c-2.52 0-4.93 1-6.74 2.74L3 8 M3 3v5h5" />

    <GeometryGroup x:Key="Icon.Search">
        <EllipseGeometry Center="11,11" RadiusX="8" RadiusY="8" />
        <LineGeometry StartPoint="16.5,16.5" EndPoint="21,21" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Check" Figures="M4 12.5l5 5 11-11" />

    <PathGeometry x:Key="Icon.Warning"
                  Figures="M12 3.5l9 16H3z M12 10v4.5 M12 17.6h.01" />

    <!-- More: a chevron, the "there is more under here" mark. -->
    <PathGeometry x:Key="Icon.More" Figures="M6 9l6 6 6-6" />

</ResourceDictionary>
