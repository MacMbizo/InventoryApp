<Window x:Class="KitchenInventory.Desktop.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In" Height="220" Width="380" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">Username</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LoginUsernameTextBox"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">Password</TextBlock>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" PasswordChanged="OnPasswordChanged" AutomationProperties.AutomationId="LoginPasswordBox"/>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource Brush.Danger}" Text="{Binding Error}"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Sign In" Margin="0,12,8,0" IsDefault="True" Click="OnSignInClick"/>
            <Button Content="Cancel" Margin="0,12,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>