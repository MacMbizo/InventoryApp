<Window x:Class="KitchenInventory.Desktop.CsvImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Import Preview" Height="520" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">
    <!-- Carried by the dialog itself: the view model builds this window directly, so it has
         to render the same whether or not the shell has put its own resources in place. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <!-- Summary Bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rows:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Total}"/>
                <TextBlock Text="Valid:" FontWeight="SemiBold" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Valid}"/>
                <TextBlock Text="Errors:" FontWeight="SemiBold" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Error}"/>
                <TextBlock Text="Adds:" FontWeight="SemiBold" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Adds}"/>
                <TextBlock Text="Updates:" FontWeight="SemiBold" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Updates}"/>
                <TextBlock Text=" "/>
                <TextBlock Text="Review the items below. Only valid rows will be imported." Foreground="{StaticResource Brush.TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" AlternationCount="2">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding IssueSummary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="Background" Value="{StaticResource Brush.WarningSurface}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding ParsedItem.Name}" Width="*"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding ParsedItem.Quantity}" Width="100"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding ParsedItem.Unit}" Width="100"/>
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}" Width="160"/>
                <DataGridTextColumn Header="Location" Binding="{Binding LocationDisplay}" Width="160"/>
                <DataGridTextColumn Header="Expiry" Binding="{Binding ParsedItem.ExpiryDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="Issues" Binding="{Binding IssueSummary}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,10">
            <Button Content="Export _Errors" Width="120" Margin="0,0,10,0" Click="OnExportErrorsClick"/>
            <Button Content="_Cancel" Width="100" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="_Import" Width="140" IsDefault="True" Click="OnImportClick"/>
        </StackPanel>
    </DockPanel>
</Window>