<Window x:Class="KitchenInventory.Desktop.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Item" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="_Item name" Target="{Binding ElementName=ItemNameTextBox}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical" Margin="5,0,0,0">
            <TextBox x:Name="ItemNameTextBox"
                     Width="200"
                     Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="128"
                     AutomationProperties.AutomationId="ItemNameTextBox"
                     AutomationProperties.Name="Item Name"
                     AutomationProperties.HelpText="Enter the item name; this field is required.">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="#FFCC0000"/>
                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Margin="2,2,0,0" Foreground="#FFCC0000" FontSize="12" AutomationProperties.AutomationId="ItemNameErrorText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ItemNameTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Text" Value="{Binding ElementName=ItemNameTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Label Grid.Row="1" Content="_Quantity" Target="{Binding ElementName=QuantityTextBox}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,6,0,16">
            <TextBox x:Name="QuantityTextBox" Height="28" Width="120"
                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     AutomationProperties.AutomationId="QuantityTextBox"/>
            <TextBlock Margin="2,2,0,0" Foreground="#FFCC0000" FontSize="12" AutomationProperties.AutomationId="QuantityErrorText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=QuantityTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Text" Value="{Binding ElementName=QuantityTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Label Grid.Row="2" Content="_Unit" Target="{Binding ElementName=UnitTextBox}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical" Margin="0,6,0,16">
            <TextBox x:Name="UnitTextBox" Height="28" Width="120"
                     Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="32"
                     AutomationProperties.AutomationId="UnitTextBox"/>
            <TextBlock Margin="2,2,0,0" Foreground="#FFCC0000" FontSize="12" AutomationProperties.AutomationId="UnitErrorText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=UnitTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Text" Value="{Binding ElementName=UnitTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Category" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3" Grid.Column="2" Margin="0,6,0,16" Height="28"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedCategoryId}" AutomationProperties.AutomationId="CategoryComboBox"/>

        <TextBlock Grid.Row="4" Text="Expiry date" FontWeight="SemiBold"/>
        <DatePicker Grid.Row="4" Grid.Column="2" Margin="0,6,0,16" SelectedDate="{Binding ExpiryDate}" AutomationProperties.AutomationId="ExpiryDatePicker"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="_Cancel" Width="90" Margin="0,0,10,0" IsCancel="True" AutomationProperties.AutomationId="CancelAddItemButton"/>
            <Button Content="_Add" Width="120" IsDefault="True" Click="OnAddClick" AutomationProperties.AutomationId="ConfirmAddItemButton"
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBooleanConverter}}"/>
        </StackPanel>
    </Grid>
</Window>