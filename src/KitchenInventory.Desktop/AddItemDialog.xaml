<Window x:Class="KitchenInventory.Desktop.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Item" Height="510" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <!-- Carried by the dialog itself: the view model builds this window directly, so it has
         to render the same whether or not the shell has put its own resources in place. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="_Item name" Target="{Binding ElementName=ItemNameTextBox}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical" Margin="5,0,0,0">
            <TextBox x:Name="ItemNameTextBox"
                     Width="200"
                     Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="128"
                     AutomationProperties.AutomationId="ItemNameTextBox"
                     AutomationProperties.Name="Item Name"
                     AutomationProperties.HelpText="Enter the item name; this field is required.">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}"/>
                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Margin="2,2,0,0" AutomationProperties.AutomationId="ItemNameErrorText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DangerText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ItemNameTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Text" Value="{Binding ElementName=ItemNameTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Label Grid.Row="1" Content="_Quantity" Target="{Binding ElementName=QuantityTextBox}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,6,0,16">
            <TextBox x:Name="QuantityTextBox" Width="120"
                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     PreviewTextInput="Quantity_PreviewTextInput"
                     DataObject.Pasting="Quantity_Pasting"
                     AutomationProperties.AutomationId="QuantityTextBox"/>
            <TextBlock Margin="2,2,0,0" AutomationProperties.AutomationId="QuantityErrorText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DangerText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=QuantityTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Text" Value="{Binding ElementName=QuantityTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Label Grid.Row="2" Content="_Unit" Target="{Binding ElementName=UnitTextBox}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical" Margin="0,6,0,16">
            <TextBox x:Name="UnitTextBox" Width="120"
                     Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="32"
                     AutomationProperties.AutomationId="UnitTextBox"/>
            <TextBlock Margin="2,2,0,0" AutomationProperties.AutomationId="UnitErrorText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DangerText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=UnitTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Text" Value="{Binding ElementName=UnitTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Category" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3" Grid.Column="2" Margin="0,6,0,16"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedCategoryId}" AutomationProperties.AutomationId="CategoryComboBox"/>

        <TextBlock Grid.Row="4" Text="Expiry date" FontWeight="SemiBold"/>
        <DatePicker Grid.Row="4" Grid.Column="2" Margin="0,6,0,16" SelectedDate="{Binding ExpiryDate}" AutomationProperties.AutomationId="ExpiryDatePicker"/>

        <TextBlock Grid.Row="5" Text="Location" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="5" Grid.Column="2" Margin="0,6,0,16"
                  ItemsSource="{Binding Locations}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedLocationId}" AutomationProperties.AutomationId="LocationComboBox"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="_Cancel" Width="90" Margin="0,0,10,0" IsCancel="True" AutomationProperties.AutomationId="CancelAddItemButton"/>
            <Button x:Name="ConfirmAddButton" Content="_Add" Width="120" IsDefault="True" Click="OnAddClick" AutomationProperties.AutomationId="ConfirmAddItemButton" Command="{Binding AddCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ItemNameTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=QuantityTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=UnitTextBox, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>