<Window x:Class="KitchenInventory.Desktop.CategoryManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manage Categories" Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <!-- Carried by the dialog itself: the view model builds this window directly, so it has
         to render the same whether or not the shell has put its own resources in place. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add" Click="Add_Click" Margin="0,0,6,0"/>
            <Button Content="Rename" Click="Rename_Click" Margin="0,0,6,0"/>
            <Button Content="Delete" Click="Delete_Click"/>
            <Separator />
            <TextBlock Text="Tip: Double-click a name to edit." VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
        </ToolBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="CategoriesGrid"
                      AutomationProperties.AutomationId="CategoriesGrid"
                      ItemsSource="{Binding Categories}" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      Margin="0,6,0,6" Grid.Row="0" IsSynchronizedWithCurrentItem="True"
                      EnableRowVirtualization="False" EnableColumnVirtualization="False" VirtualizingPanel.IsVirtualizing="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtUtc}" IsReadOnly="True" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" Margin="0,0,12,0" Visibility="Collapsed"/>
                <Button Content="Close" Width="92" IsDefault="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>