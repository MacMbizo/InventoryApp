<Window x:Class="KitchenInventory.Desktop.PrivacyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crash Reporting" Height="260" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Help improve Kitchen Inventory by sending anonymous crash reports."
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="12" Background="#FFF8F8F8" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="What we collect"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="• Crash details (stack traces, error types)\n• App version and OS info\n• No inventory contents or personal data"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="You can change this later in Settings → Privacy."
                           Foreground="Gray"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoThanksButton" Content="No thanks" MinWidth="100" Margin="0,0,8,0" IsCancel="True" Click="NoThanks_Click"/>
                <Button x:Name="EnableButton" Content="Enable crash reporting" MinWidth="160" IsDefault="True" Click="Enable_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>