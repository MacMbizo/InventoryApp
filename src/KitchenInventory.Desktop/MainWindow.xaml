<Window x:Class="KitchenInventory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KitchenInventory.Desktop.ViewModels"
        xmlns:val="clr-namespace:KitchenInventory.Desktop.Validations"
        xmlns:conv="clr-namespace:KitchenInventory.Desktop.Converters"
        xmlns:svc="clr-namespace:KitchenInventory.Desktop.Services"
        xmlns:local="clr-namespace:KitchenInventory.Desktop"
        mc:Ignorable="d"
        Title="Kitchen Inventory" Height="700" Width="1100"
        MinHeight="600" MinWidth="960"
        Validation.Error="OnValidationError">
    <!-- Converters -->
    <Window.Resources>
        <conv:NeedsAttentionConverter x:Key="NeedsAttentionConverter" />
        <conv:HideZeroIdConverter x:Key="HideZeroIdConverter" />
        <conv:MovementTypeConverter x:Key="MovementTypeConverter" />
        <conv:MovementItemNameConverter x:Key="MovementItemNameConverter" />
        <!-- Numbers and dates as a reader says them: "10" not "10.00", "30 Nov 2026" not
             "2026-11-30", "in 6 days" when that is the question, and stored UTC shown on the
             reader's own clock without the seconds. -->
        <conv:QuantityDisplayConverter x:Key="QuantityDisplayConverter" />
        <conv:FriendlyDateConverter x:Key="FriendlyDateConverter" />
        <conv:FriendlyDateConverter x:Key="RelativeDateConverter" Mode="Relative" />
        <conv:FriendlyDateConverter x:Key="LocalTimeConverter" Mode="LocalTime" />
        <!-- What a row should say about its item. The rules are ItemStatusService's, which is the
             same place the Problems tab reads them from. -->
        <conv:ItemStatusConverter x:Key="ItemStatusConverter" />
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.FocusSearchCommand}" Executed="FocusSearch_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.EditSelectedItemCommand}" Executed="EditSelectedItem_Executed" />
    </Window.CommandBindings>
    <!-- Keyboard shortcuts: the everyday actions reachable without hunting through the toolbar.
         Each one is named in the tooltip of the button it duplicates. -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddItemCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveChangesCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F2" Command="{x:Static local:MainWindow.EditSelectedItemCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoRemoveCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Top: Menu + Toolbar stacked -->
        <DockPanel Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Settings" Click="Open_Settings_Click" />
                <MenuItem x:Name="ManageUsersMenuItem" Header="_Manage users" Click="Manage_Users_Click" AutomationProperties.AutomationId="ManageUsersMenuItem" />
                <MenuItem Header="_Reports" Click="Open_Reports_Click" AutomationProperties.AutomationId="ReportsMenuItem" />
                <MenuItem Header="Your _data" Click="Open_DatabaseMaintenance_Click"
                          ToolTip="Back up, check or restore your saved inventory data"
                          AutomationProperties.AutomationId="DatabaseMaintenanceMenuItem" />
                <MenuItem Header="_Help">
                    <MenuItem Header="_About Kitchen Inventory" Click="Help_About_Click" AutomationProperties.AutomationId="AboutMenuItem"/>
                    <Separator/>
                    <MenuItem Header="_Diagnostics" Click="Help_Diagnostics_Click"/>
                </MenuItem>
            </Menu>
            <!-- Actions. Thirteen equal buttons meant none of them was a next step and Remove
                 sat one mis-click from its neighbours. Now there is one primary action, the
                 three stock actions that act on the selected row, and everything occasional
                 behind "More". Changing the stock and narrowing the list are different jobs,
                 so the filters get their own bar underneath rather than trailing the actions. -->
            <Border DockPanel.Dock="Top" Padding="{StaticResource Spacing.Sm}" BorderThickness="0,0,0,1"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.Border}">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarPrimaryButton}" Content="Add item" Tag="{StaticResource Icon.Add}" Command="{Binding AddItemCommand}" ToolTip="Add something new to the store (Ctrl+N)" AutomationProperties.AutomationId="AddItemButton" />

                        <!-- These three change the stock of whichever row is selected. The label
                             names that condition, so they are not simply three dead buttons. -->
                        <Border Width="1" Height="22" VerticalAlignment="Center" Margin="4,0,12,4"
                                Background="{StaticResource Brush.Border}" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Text" Value="On the selected item:" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Pick an item in the list:" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource ToolbarButton}" Content="Take in stock" Tag="{StaticResource Icon.StockIn}" Command="{Binding AddStockCommand}" ToolTip="Record stock arriving in the store" AutomationProperties.AutomationId="AddStockButton" />
                        <Button Style="{StaticResource ToolbarButton}" Content="Take out stock" Tag="{StaticResource Icon.StockOut}" Command="{Binding ConsumeStockCommand}" ToolTip="Record stock used from the store" AutomationProperties.AutomationId="ConsumeStockButton" />
                        <Button Style="{StaticResource ToolbarButton}" Content="Recount" Tag="{StaticResource Icon.Recount}" Command="{Binding AdjustStockCommand}" ToolTip="Set the stock to what you actually counted" AutomationProperties.AutomationId="AdjustStockButton" />

                        <Button x:Name="MoreButton" Style="{StaticResource ToolbarButton}"
                                Content="More" Tag="{StaticResource Icon.More}"
                                Margin="8,0,8,4" Click="MoreActions_Click"
                                ToolTip="The occasional jobs: saving, reloading, spreadsheets, categories, locations, the unit converter and reports"
                                AutomationProperties.AutomationId="OverflowButton" />
                    </WrapPanel>

                    <!-- The occasional actions, as real buttons rather than a pop-up menu: they
                         keep their names and stay reachable with the keyboard, and pressing
                         "More" again closes the drawer. -->
                    <Border x:Name="MorePanel" Visibility="Collapsed" Margin="0,4,0,0"
                            Padding="{StaticResource Spacing.Xs}"
                            Background="{StaticResource Brush.SurfaceSunken}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}">
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButton}" Content="Save changes" Tag="{StaticResource Icon.Save}" Command="{Binding SaveChangesCommand}" ToolTip="Save the changes you have made in the table (Ctrl+S)" AutomationProperties.AutomationId="SaveChangesButton"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Refresh" Tag="{StaticResource Icon.Refresh}" Command="{Binding RefreshCommand}" ToolTip="Reload the list from the saved data (Ctrl+R or F5)" AutomationProperties.AutomationId="RefreshButton" />
                            <Button Style="{StaticResource ToolbarButton}" Content="Import items (CSV)" Tag="{StaticResource Icon.Import}" Command="{Binding ImportItemsCsvCommand}" ToolTip="Bring in a list of items from a spreadsheet file" AutomationProperties.AutomationId="ImportItemsCsvButton" />
                            <Button Style="{StaticResource ToolbarButton}" Content="Export items (CSV)" Tag="{StaticResource Icon.Export}" Command="{Binding ExportItemsCsvCommand}" ToolTip="Save the list as a spreadsheet file" AutomationProperties.AutomationId="ExportItemsCsvButton" />
                            <Button Style="{StaticResource ToolbarButton}" Content="Manage categories" Tag="{StaticResource Icon.Category}" Command="{Binding ManageCategoriesCommand}" AutomationProperties.AutomationId="ManageCategoriesButton" />
                            <Button Style="{StaticResource ToolbarButton}" Content="Manage locations" Tag="{StaticResource Icon.Location}" Command="{Binding ManageLocationsCommand}" AutomationProperties.AutomationId="ManageLocationsButton" />
                            <Button Style="{StaticResource ToolbarButton}" Content="Unit converter" Tag="{StaticResource Icon.Convert}" Click="Open_UnitConverter_Click" ToolTip="Convert between kg/g/mg and l/ml/cl/dl" AutomationProperties.AutomationId="UnitConverterButton" />
                            <Button Style="{StaticResource ToolbarButton}" Content="Reports" Tag="{StaticResource Icon.Reports}" Click="Open_Reports_Click" ToolTip="Generate and export inventory reports" AutomationProperties.AutomationId="ReportsButton" />
                            <!-- Last and on its own, because deleting is the one action here that
                                 cannot be undone by pressing Save again. -->
                            <Button Style="{StaticResource ToolbarButton}" Content="Remove item" Tag="{StaticResource Icon.Remove}" Command="{Binding DeleteItemCommand}" ToolTip="Take something off the list (Delete)" AutomationProperties.AutomationId="DeleteItemButton" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Filters. Their own bar, on the plain surface, so it is plain at a glance that
                 these narrow the list rather than change the stock. -->
            <Border DockPanel.Dock="Top" Padding="{StaticResource Spacing.Sm}" BorderThickness="0,0,0,1"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}">
                <WrapPanel Orientation="Horizontal">
                    <!-- Category Filter -->
                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="180"
                              ItemsSource="{Binding Categories}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.AutomationId="CategoryFilterCombo"/>

                    <!-- Location Filter -->
                    <TextBlock Text="Location:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox Width="180"
                              ItemsSource="{Binding Locations}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedLocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.AutomationId="LocationFilterCombo"/>

                    <!-- Search -->
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox x:Name="SearchBox" Width="240"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type part of an item's name to narrow the list (Ctrl+F)"
                             AutomationProperties.AutomationId="SearchBox"/>
                    <CheckBox Content="Problems only" Margin="16,0,0,0" VerticalAlignment="Center"
                              ToolTip="Show only items that are low, out of stock or going out of date"
                              IsChecked="{Binding ShowNeedsAttentionOnly}"
                              AutomationProperties.AutomationId="NeedsAttentionOnlyCheckBox"/>
                </WrapPanel>
            </Border>
        </DockPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Items grid -->
            <DataGrid Grid.Column="0"
                      x:Name="ItemsGrid"
                      ItemsSource="{Binding ItemsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Margin="8,8,4,8"
                      SelectionChanged="DataGrid_SelectionChanged"
                      CurrentCellChanged="DataGrid_CurrentCellChanged"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MinColumnWidth="90"
                      ColumnWidth="*"
                      AutomationProperties.AutomationId="ItemsDataGrid">
                <DataGrid.RowStyle>
                    <!-- Based on the shared row style, so the 44 px row height survives. The
                         attention tint steps aside while a row is selected, or a selected row
                         that needs attention would look like it was not selected at all. -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="False"/>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource NeedsAttentionConverter}">
                                                <Binding Path="Quantity"/>
                                                <Binding Path="ExpiryDate"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.LowStockThreshold"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.ExpiringSoonDays"/>
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource Brush.AttentionRow}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <!-- Based on the shared text-box style so an edited cell keeps the same
                         border and padding; only the error presentation is added here. -->
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Validation.ErrorTemplate">
                            <Setter.Value>
                                <ControlTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Style="{StaticResource DangerText}" Margin="5,0,0,0"
                                                   Text="{Binding ElementName=adornedElementPlaceholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                                        <AdornedElementPlaceholder Name="adornedElementPlaceholder"/>
                                    </DockPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource QuantityDisplayConverter}}" Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <!-- Quantities are the only numeric column, so the typing guard and the
                                 paste conversion are attached here rather than to every cell. -->
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <EventSetter Event="PreviewTextInput" Handler="Quantity_PreviewTextInput"/>
                                <EventSetter Event="DataObject.Pasting" Handler="Quantity_Pasting"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <!-- A unit is a word or two ("kg", "pcs"), so it takes what it needs rather than
                         a full share of the width; the Status column beside it has more to say. -->
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                    <!-- Status. The row tint is the same message in colour alone, which is no message
                         at all to a colour-blind eye; this says what and how bad, in words, with an
                         icon so it survives being read in greyscale. The full sentence is on the
                         tooltip, because the column is narrow. -->
                    <DataGridTemplateColumn Header="Status" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl VerticalAlignment="Center">
                                    <ContentControl.Content>
                                        <MultiBinding Converter="{StaticResource ItemStatusConverter}">
                                            <Binding Path="Quantity"/>
                                            <Binding Path="ExpiryDate"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.LowStockThreshold"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" Path="DataContext.ExpiringSoonDays"/>
                                            <Binding Path="Unit"/>
                                        </MultiBinding>
                                    </ContentControl.Content>
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        ToolTip="{Binding Text}">
                                                <!-- The default look is set in a Style, not on the
                                                     element: a local value would outrank the triggers
                                                     below and nothing would ever turn amber or red. -->
                                                <Path x:Name="StatusIcon" StrokeThickness="1.8"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                                      VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                                            <Setter Property="Stroke" Value="{StaticResource Brush.Success}" />
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock x:Name="StatusWords" Text="{Binding Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static svc:ItemStatusTone.Watch}">
                                                    <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource Icon.Warning}" />
                                                    <Setter TargetName="StatusIcon" Property="Stroke" Value="{StaticResource Brush.Warning}" />
                                                    <Setter TargetName="StatusWords" Property="Foreground" Value="{StaticResource Brush.WarningStrong}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static svc:ItemStatusTone.Urgent}">
                                                    <Setter TargetName="StatusIcon" Property="Data" Value="{StaticResource Icon.Warning}" />
                                                    <Setter TargetName="StatusIcon" Property="Stroke" Value="{StaticResource Brush.Danger}" />
                                                    <Setter TargetName="StatusWords" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Insert Category column -->
                    <DataGridTemplateColumn Header="Category" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category.Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedValuePath="Id"
                                    DisplayMemberPath="Name"
                                    SelectedValue="{Binding CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    >
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Visibility" Value="{Binding Id, Converter={StaticResource HideZeroIdConverter}}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Expiry date" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- The date as it would be said out loud, with the distance to
                                     it ("in 6 days") on the tooltip. -->
                                <TextBlock Text="{Binding ExpiryDate, Converter={StaticResource FriendlyDateConverter}}"
                                           ToolTip="{Binding ExpiryDate, Converter={StaticResource RelativeDateConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!-- Editing stays in the unambiguous yyyy-MM-dd the CSV import and
                                     export use, so a typed date cannot be misread. -->
                                <TextBox Text="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged, StringFormat=yyyy-MM-dd}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!-- Location column -->
                    <DataGridTemplateColumn Header="Location" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Location.Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding DataContext.Locations, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedValuePath="Id"
                                    DisplayMemberPath="Name"
                                    SelectedValue="{Binding LocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    >
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Visibility" Value="{Binding Id, Converter={StaticResource HideZeroIdConverter}}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state. The grid stays underneath so selection and the keyboard shortcuts
                 keep working, but on day one there is nothing to read and something to say. -->
            <Border Grid.Column="0" Margin="8,8,4,8" Padding="24"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Style="{StaticResource SectionHeading}" HorizontalAlignment="Center"
                               Text="Nothing in the kitchen yet" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0"
                               Text="Add the first thing you keep track of — rice, cooking oil, floor cleaner — and this list will show you what is running low." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Add your first item"
                                Command="{Binding AddItemCommand}"
                                AutomationProperties.AutomationId="EmptyStateAddButton" />
                        <Button Content="Import a spreadsheet" Margin="8,0,0,0"
                                Command="{Binding ImportItemsCsvCommand}"
                                AutomationProperties.AutomationId="EmptyStateImportButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- No results. Distinct from the state above: there is something here, the filter is
                 just hiding it — so the action is to clear the filter, not to add an item. -->
            <Border Grid.Column="0" Margin="8,8,4,8" Padding="24"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}"
                    Visibility="{Binding HasNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Style="{StaticResource SectionHeading}" HorizontalAlignment="Center"
                               Text="{Binding NoMatchesMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0"
                               Text="Your items are still here — the search and filters are hiding them." />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0"
                            Content="Show everything" Command="{Binding ClearFiltersCommand}"
                            AutomationProperties.AutomationId="ClearFiltersButton" />
                </StackPanel>
            </Border>

            <!-- Audit/Movements side panel -->
            <Border Grid.Column="1" Margin="4,8,8,8" Padding="12"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}">
                <DockPanel>
                    <TextBlock Text="Activity" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                    <TabControl>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Problems" />
                                    <TextBlock Text="{Binding AlertsCount, StringFormat=' ({0})'}" Foreground="{StaticResource Brush.Danger}" FontWeight="Bold" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Anything running low, out of stock or going out of date" Style="{StaticResource CaptionText}" />
                                    <TextBlock>
                                        <Run Text="Running low: " /><Run Text="{Binding LowStockCount, Mode=OneWay}" />
                                        <Run Text="  Use soon: " /><Run Text="{Binding ExpiringSoonCount, Mode=OneWay}" />
                                        <Run Text="  Out of date: " /><Run Text="{Binding ExpiredCount, Mode=OneWay}" />
                                        <Run Text="  Urgent: " /><Run Text="{Binding CriticalAlertsCount, Mode=OneWay}" FontWeight="Bold" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- One card per problem rather than five fixed-width columns in a
                                     panel narrower than their total. Cards reflow at any width, and
                                     each one can lead with the sentence a person would say. The words
                                     are the same ones the Status column shows, so the two cannot tell
                                     the reader different things. -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Alerts}" AutomationProperties.AutomationId="AlertsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CardBorder" Margin="0,0,0,8"
                                                        AutomationProperties.AutomationId="AlertCard">
                                                    <!-- Card's own look in a Style, so the severity
                                                         triggers below can override it. -->
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.WarningBorder}" />
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path x:Name="CardIcon"
                                                                  StrokeThickness="1.8"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                                                  VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="{StaticResource Icon.Warning}" />
                                                                        <Setter Property="Stroke" Value="{StaticResource Brush.Warning}" />
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock x:Name="CardTitle" Text="{Binding Headline}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.WarningStrong}" />
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource CaptionText}" Margin="24,6,0,0"
                                                                   Text="{Binding Message}" />
                                                        <TextBlock x:Name="CardWhere" Style="{StaticResource CaptionText}"
                                                                   Margin="24,2,0,0"
                                                                   Text="{Binding Location, StringFormat='Stored in {0}'}" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static svc:AlertSeverity.Critical}">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Brush.DangerBorder}" />
                                                        <Setter TargetName="CardIcon" Property="Stroke" Value="{StaticResource Brush.Danger}" />
                                                        <Setter TargetName="CardTitle" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Location}" Value="">
                                                        <Setter TargetName="CardWhere" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- All clear. Five empty columns say nothing; the good news is
                                     worth saying outright. -->
                                <Border Grid.Row="1" Padding="16" VerticalAlignment="Top"
                                        Background="{StaticResource Brush.SuccessSurface}"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Md}"
                                        Visibility="{Binding IsAllClear, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="AllClearPanel">
                                    <StackPanel>
                                        <TextBlock Text="Nothing needs your attention" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Success}" />
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="No stock is running low and nothing is close to its use-by date. This tab will fill up on its own when that changes." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Item history">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Everything that has happened to the item you selected" Style="{StaticResource CaptionText}" />
                                    <Button Grid.Column="1" Content="Save as CSV" Command="{Binding ExportSelectedMovementsCsvCommand}" />
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{Binding SelectedMovements}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="When" Width="120" DisplayMemberBinding="{Binding TimestampUtc, Converter={StaticResource LocalTimeConverter}}" />
                                            <GridViewColumn Header="What happened" Width="110">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource MovementTypeConverter}}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Amount" Width="70" DisplayMemberBinding="{Binding Quantity, Converter={StaticResource QuantityDisplayConverter}}" />
                                            <GridViewColumn Header="Note" Width="140" DisplayMemberBinding="{Binding Reason}" />
                                            <GridViewColumn Header="By" Width="100" DisplayMemberBinding="{Binding User}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Recent activity">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="The last 50 things that happened, newest first" Style="{StaticResource CaptionText}" />
                                    <Button Grid.Column="1" Content="Save as CSV" Command="{Binding ExportRecentMovementsCsvCommand}" />
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{Binding RecentMovements}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="When" Width="120" DisplayMemberBinding="{Binding TimestampUtc, Converter={StaticResource LocalTimeConverter}}" />
                                            <GridViewColumn Header="Item" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource MovementItemNameConverter}">
                                                                    <Binding Path="ItemId" />
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.MovementItemNames" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="What happened" Width="110">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource MovementTypeConverter}}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Amount" Width="70" DisplayMemberBinding="{Binding Quantity, Converter={StaticResource QuantityDisplayConverter}}" />
                                            <GridViewColumn Header="Note" Width="140" DisplayMemberBinding="{Binding Reason}" />
                                            <GridViewColumn Header="By" Width="100" DisplayMemberBinding="{Binding User}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
        <!-- End main content -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <!-- Undo strip: only visible for a short while after something has been removed. -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding CanUndoRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding UndoMessage}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SmallButton}" Command="{Binding UndoRemoveCommand}"
                            ToolTip="Put the removed item back (Ctrl+Z)"
                            AutomationProperties.AutomationId="UndoRemoveButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Undo}" Stroke="{StaticResource Brush.Danger}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Undo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
