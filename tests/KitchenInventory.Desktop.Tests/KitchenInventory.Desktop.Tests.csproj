<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Required so coverlet can resolve WPF framework assemblies when instrumenting KitchenInventory.Desktop -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
  <!--
    Code-coverage quality gate (min 80% per project-documentation/development-rules.md).
    The floor applies to testable logic only: WPF XAML code-behind, EF migrations and
    generated code are excluded from the denominator because that surface is covered by
    UI automation, not unit/integration tests.
    Run the gate: dotnet test on this csproj with test filter Category!=UI and /p:CollectCoverage=true.
  -->
  <PropertyGroup>
    <Include>[KitchenInventory.*]*</Include>
    <!-- ExcludeByAttribute must NOT include CompilerGeneratedAttribute: async/iterator bodies
         live in compiler-generated state machines and would be dropped from the denominator. -->
    <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <ExcludeByFile>**/*.xaml.cs,**/obj/**,**/Migrations/**</ExcludeByFile>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="xunit.stafact" Version="1.1.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- UI automation for smoke test -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- Code coverage for the 80% line-coverage quality floor (msbuild mode, see gate below) -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KitchenInventory.Desktop\KitchenInventory.Desktop.csproj" />
    <ProjectReference Include="..\..\src\KitchenInventory.Data\KitchenInventory.Data.csproj" />
    <ProjectReference Include="..\..\src\KitchenInventory.Domain\KitchenInventory.Domain.csproj" />
  </ItemGroup>
</Project>